Screen { background: #101820; color: #d9e4ee; }
#banner { height: 1; padding: 0 2; background: #1b2c3a; color: #8bded0; text-style: bold; }
#connection { height: 1; padding: 0 2; color: #a9bed0; }
#resize { display: none; height: 1fr; content-align: center middle; color: #edc47c; }
#body { height: 1fr; margin: 0 2; padding: 0 1; border: round #365064; }
#session { height: 1; text-style: bold; }
#mode { height: 1; color: #8bded0; }
#identity { height: 2; color: #a9bed0; }
#health { height: 3; }
#notice { height: 1; color: #edc47c; }
#control_note { height: 1; color: #edc47c; }
#view_title { height: 1; color: #8bded0; text-style: bold; }
#view_tabs { height: 2; display: none; }
#collection { height: 1; color: #a9bed0; }
#workspace { height: 1fr; }
#records { height: 2fr; min-height: 5; }
#diagnostics { height: 1fr; min-height: 7; }
#diagnostic_divider { height: 1; background: #1b2c3a; color: #8bded0; }
#diagnostic_divider:focus { text-style: bold reverse; }
.compact #health { height: 1; }
.diagnostics_expanded #identity, .diagnostics_expanded #health,
.diagnostics_expanded #control_note,
.diagnostics_expanded #view_title, .diagnostics_expanded #view_tabs,
.diagnostics_expanded #collection { display: none; }
#records:focus { border: solid #8bded0; }
DataTable > .datatable--cursor { text-style: bold reverse; }
#detail_scroll { height: 1fr; border-top: solid #365064; }
#detail_scroll:focus { border: solid #8bded0; }
#record_details { height: auto; }
Footer { background: #1b2c3a; }
Confirmation, Help { align: center middle; background: #101820 85%; }
.dialog { width: 80; max-width: 95%; height: auto; max-height: 95%; padding: 1 2; background: #1b2c3a; border: round #8bded0; }
.dialog Static { height: auto; }
.dialog_title { text-style: bold; color: #8bded0; margin-bottom: 1; }
#confirm_warning { margin: 1 0; color: #edc47c; }
#confirm_action { margin: 1 0; }
#confirm_error { color: #ef9696; }
.ascii #body, .ascii #records:focus, .ascii #detail_scroll:focus,
.ascii .dialog, .ascii Input, .ascii Input:focus { border: ascii #8bded0; }
.ascii #detail_scroll { border-top: ascii #365064; }
.ascii #records, .ascii #detail_scroll, .ascii .dialog { scrollbar-size: 0 0; }

#diagnostic_tabs { height: 2; }
.compact #diagnostic_tabs { height: 1; }
#diagnostic_status { height: 1; color: #a9bed0; }
#diagnostic_records { height: 1fr; min-height: 2; }
#diagnostic_records:focus { border: solid #8bded0; }
#diagnostic_detail_scroll { height: 3; border-top: solid #365064; }
#diagnostic_details { height: auto; }
.ascii #diagnostic_records:focus { border: ascii #8bded0; }
.ascii #diagnostic_records, .ascii #diagnostic_detail_scroll { scrollbar-size: 0 0; }

.compact #view_tabs { height: 1; }
#finding_filters { height: 1; }
#finding_filters Checkbox { width: auto; height: 1; padding: 0 1; }
#finding_filters Button { width: auto; min-width: 0; height: 1; padding: 0 1; border: none; }
