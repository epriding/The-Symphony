Screen { background: #101820; color: #d9e4ee; }
#banner { height: 3; padding: 1 2; background: #1b2c3a; color: #8bded0; text-style: bold; }
#connection { height: 2; padding: 0 2; color: #a9bed0; }
#body { height: 1fr; margin: 0 2 1 2; padding: 1 2; border: round #365064; }
#session { height: auto; margin-bottom: 1; text-style: bold; }
#mode { height: auto; color: #8bded0; margin-bottom: 1; }
#identity { height: auto; color: #a9bed0; margin-bottom: 1; }
#health { height: auto; margin-bottom: 1; }
#notice { height: auto; color: #edc47c; }
Footer { background: #1b2c3a; }
#connection { height: 1; }
#body { padding: 0 1; margin-bottom: 0; }
#session, #mode { height: 1; margin-bottom: 0; }
#identity { height: 2; margin-bottom: 0; }
#health { height: 3; margin-bottom: 0; }
#notice { height: 2; }
#collection { height: 2; color: #8bded0; }
#records { height: 1fr; min-height: 5; }
#records:focus { border: solid #8bded0; }
#detail_scroll { height: 4; border-top: solid #365064; }
#detail_scroll:focus { border: solid #8bded0; }
#record_details { height: auto; }
